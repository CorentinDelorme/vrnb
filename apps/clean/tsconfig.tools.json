/* Type-check for Node tooling files (scripts, Playwright config).
 * The Next.js app config (tsconfig.json) intentionally keeps browser-oriented
 * defaults. Tooling files need Node types, so they get their own project which
 * the IDE can attach to instead of using an inferred project without
 * @types/node. */
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"],
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true
  },
  "include": ["scripts/**/*.ts", "playwright.config.ts"]
}
