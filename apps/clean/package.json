{
  "name": "clean",
  "version": "1.6.0",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 4200",
    "start": "next dev -p 4200",
    "build": "next build",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint --max-warnings 0",
    "lint:fix": "eslint --fix . && prettier --write .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:tours": "bun tsx scripts/generate-tours.ts && bun run lint:fix",
    "generate:routes": "bun tsx scripts/generate-start-end-gpx.ts",
    "generate:pdfs": "bun tsx scripts/generate-pdfs.ts",
    "generate:state": "bun tsx scripts/refresh-generation-state.ts",
    "generate:one": "bun tsx scripts/generate-one.ts",
    "generate:zone-pdf": "bun tsx scripts/generate-zone-pdf.ts",
    "generate:all": "bun tsx scripts/generate-all.ts",
    "e2e": "playwright test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "htmlWhitespaceSensitivity": "ignore",
    "plugins": [
      "prettier-plugin-tailwindcss",
      "prettier-plugin-organize-imports",
      "prettier-plugin-organize-attributes"
    ],
    "overrides": [
      {
        "files": "*.ts",
        "options": {
          "parser": "typescript"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@tmcw/togeojson": "^7.1.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "leaflet-arrowheads": "^1.4.0",
    "leaflet.fullscreen": "^5.3.3",
    "next": "16.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.22.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.64.1",
    "@repo/eslint-config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@xmldom/xmldom": "^0.9.12",
    "eslint": "^9.16.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "jsdom": "^29.0.1",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-attributes": "^1.0.0",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
