{
  "name": "clean",
  "version": "1.6.0",
  "scripts": {
    "ng": "ng",
    "dev": "ng serve",
    "start": "ng serve",
    "start:production": "ng serve --configuration production",
    "start:host": "ng serve --host 0.0.0.0",
    "build": "ng build",
    "check-types": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:tours": "bun tsx scripts/generate-tours.ts && bun run lint:fix",
    "generate:routes": "bun tsx scripts/generate-start-end-gpx.ts",
    "generate:pdfs": "bun tsx scripts/generate-pdfs.ts",
    "generate:one": "bun tsx scripts/generate-one.ts",
    "generate:zone-pdf": "bun tsx scripts/generate-zone-pdf.ts",
    "generate:all": "bun run generate:routes && bun run generate:tours && bun run generate:pdfs",
    "e2e": "ng e2e"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "htmlWhitespaceSensitivity": "ignore",
    "plugins": [
      "prettier-plugin-tailwindcss",
      "prettier-plugin-organize-imports",
      "prettier-plugin-organize-attributes"
    ],
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      },
      {
        "files": "*.ts",
        "options": {
          "parser": "typescript"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-server": "22.2.3",
    "@angular/router": "^22.2.3",
    "@hugeicons/angular": "^1.0.12",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@tmcw/togeojson": "^7.1.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "canvas-confetti": "^1.9.4",
    "daisyui": "^5.7.50",
    "leaflet": "^1.9.4",
    "leaflet-arrowheads": "^1.4.0",
    "leaflet.fullscreen": "^5.3.3",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.6.0",
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@angular/ssr": "22.2.3",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@xmldom/xmldom": "^0.9.12",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "jspdf": "^4.2.1",
    "jsdom": "^29.0.1",
    "jspdf-autotable": "^5.0.9",
    "pdf-lib": "^1.17.1",
    "playwright-ng-schematics": "^22.1.2",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-attributes": "^1.0.0",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "^5.0.5"
  }
}
